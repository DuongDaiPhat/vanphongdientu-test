# Copy to .env; existing environment variables take precedence. Never commit .env.
BASE_URL=https://vanphongdientu.utc.edu.vn/Login
BROWSER=chrome
HEADLESS=true
TIMEOUT=10
PAGE_LOAD_TIMEOUT=35
ENVIRONMENT=production
REPORT_DIR=reports
# Optional offline driver/browser paths:
DRIVER_PATH=
BROWSER_BINARY=
# Populate only after observing the target's DOM and error messages.
ERROR_SELECTOR=
AUTH_ERROR_PATTERN=
USERNAME_ERROR_PATTERN=
PASSWORD_ERROR_PATTERN=
CAPTCHA_ERROR_PATTERN=
AUTHENTICATED_SELECTOR=
KNOWN_USERNAME=
KNOWN_WRONG_PASSWORD=
# Advanced CAPTCHA cases require a verified specification and test environment.
CAPTCHA_IMAGE_SELECTOR=
CAPTCHA_REFRESH_SELECTOR=
CAPTCHA_TTL_SECONDS=
CAPTCHA_TTL_MARGIN=1
CAPTCHA_TRIGGER_ATTEMPTS=
MAX_LOGIN_ATTEMPTS=5
CAPTCHA_SINGLE_USE=false
RESET_SELECTOR=
APPROVED_TEST_HOST=
ASSISTED_TIMEOUT=60
