# Observed by Selenium on UTC, 2026-10-08. No account credentials are stored here.
BASE_URL=https://vanphongdientu.utc.edu.vn/Login
ENVIRONMENT=production
BROWSER=chrome
HEADLESS=true
TIMEOUT=10
PAGE_LOAD_TIMEOUT=35
REPORT_DIR=reports/utc-live
ERROR_SELECTOR=form[action='/Login'][method='post'] > div.error
AUTH_ERROR_PATTERN=^Tài khoản hoặc mật khẩu không đúng\.$
USERNAME_ERROR_PATTERN=^Bạn chưa nhập tên đăng nhập$
PASSWORD_ERROR_PATTERN=^Bạn chưa nhập mật khẩu$
# CAPTCHA was not visible during initial surveys; no error message is guessed.
CAPTCHA_ERROR_PATTERN=
