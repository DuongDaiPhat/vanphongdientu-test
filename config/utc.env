# Observed by Selenium on UTC, 2026-10-08. No account credentials are stored here.
BASE_URL=https://vanphongdientu.utc.edu.vn/Login
ENVIRONMENT=production
BROWSER=chrome
HEADLESS=true
TIMEOUT=10
PAGE_LOAD_TIMEOUT=35
REPORT_DIR=reports/utc-live
ERROR_SELECTOR=form[action='/Login'][method='post'] > div.error
AUTH_ERROR_PATTERN=^Tài khoản hoặc mật khẩu không đúng\.$
USERNAME_ERROR_PATTERN=^Bạn chưa nhập tên đăng nhập$
PASSWORD_ERROR_PATTERN=^Bạn chưa nhập mật khẩu$
# CAPTCHA was not visible during initial surveys; no error message is guessed.
CAPTCHA_ERROR_PATTERN=^Mã bảo mật không đúng$
CAPTCHA_IMAGE_SELECTOR=form[action='/Login'][method='post'] img#captcha
CAPTCHA_REFRESH_SELECTOR=form[action='/Login'][method='post'] a[onclick*="getElementById('captcha')"]
# Observed in two isolated sessions on 2026-10-08; TC22 verifies this behavior.
CAPTCHA_TRIGGER_ATTEMPTS=3
RESET_STRATEGY=fresh_browser
# User confirmed there is no automatic CAPTCHA expiry; TC17 observes 60 seconds.
CAPTCHA_NO_EXPIRY=true
CAPTCHA_OBSERVATION_SECONDS=60
# User confirmed each rejected login generates a new CAPTCHA challenge.
CAPTCHA_SINGLE_USE=true
